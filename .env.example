# Database Configuration for FraudNet
# Copy this file to .env and fill in your actual database credentials
# The .env file is ignored by git to keep your credentials secure

# PostgreSQL Connection String
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://username:password@localhost:5432/fraudnet

# Alternative: Individual connection parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=username
# DB_PASSWORD=password
# DB_NAME=fraudnet

# Data Split Configuration (percentages as decimals)
# Training data percentage (0.0 - 1.0)
TRAIN_SPLIT=0.7

# Testing data percentage (0.0 - 1.0)
TEST_SPLIT=0.2

# Demo data percentage (0.0 - 1.0)
# This small portion will be exported for web demo
DEMO_SPLIT=0.1

# Number of demo records to export for web demonstration
DEMO_RECORD_COUNT=10

# Output file for demo data (default: demo_data.json)
DEMO_OUTPUT_FILE=demo_data.json
