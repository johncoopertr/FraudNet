# Database Configuration for FraudNet
# Copy this file to .env and fill in your actual database credentials
# The .env file is ignored by git to keep your credentials secure

# Microsoft SQL Server Connection String (ADO.NET format)
# Format: Server=hostname;Database=database;User Id=username;Password=password;TrustServerCertificate=true
DATABASE_URL=Server=localhost;Database=fraudnet;User Id=fraudnet_user;Password=your_password_here;TrustServerCertificate=true

# Alternative formats:
# With instance: Server=hostname\SQLEXPRESS;Database=fraudnet;User Id=username;Password=password;TrustServerCertificate=true
# With port: Server=hostname,1433;Database=fraudnet;User Id=username;Password=password;TrustServerCertificate=true
# Windows Auth: Server=hostname;Database=fraudnet;Integrated Security=true;TrustServerCertificate=true

# Data Split Configuration (percentages as decimals)
# Training data percentage (0.0 - 1.0)
TRAIN_SPLIT=0.7

# Testing data percentage (0.0 - 1.0)
TEST_SPLIT=0.2

# Demo data percentage (0.0 - 1.0)
# This small portion will be exported for web demo
DEMO_SPLIT=0.1

# Number of demo records to export for web demonstration
DEMO_RECORD_COUNT=10

# Output file for demo data (default: demo_data.json)
DEMO_OUTPUT_FILE=demo_data.json
